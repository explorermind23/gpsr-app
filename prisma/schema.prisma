// GPSR Compliance Hub — data model
// Designed multi-platform (Shopify + Amazon + TikTok + eBay/Etsy/Temu) and DPP-ready.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  refreshToken        String?
  refreshTokenExpires DateTime?
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Shop {
  id                   String   @id @default(cuid())
  shopDomain           String   @unique
  plan                 Plan     @default(FREE)
  planInterval         String   @default("MONTHLY") // MONTHLY | ANNUAL
  planActivatedAt      DateTime?
  installedAt          DateTime @default(now())
  onboardingDone       Boolean  @default(false)
  sellsIntoEU          Boolean  @default(true)
  defaultLocale        String   @default("en")
  euMarketLocales      String[] @default([])
  defaultRetentionYears Int     @default(10)
  recallAlertsEnabled  Boolean  @default(true)
  weeklyDigestEnabled  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  responsiblePersons ResponsiblePerson[]
  manufacturers      Manufacturer[]
  templates          ComplianceTemplate[]
  productCompliances ProductCompliance[]
  documents          ComplianceDocument[]
  channelExports     ChannelExport[]
  incidentLogs       IncidentLog[]
  auditEvents        AuditEvent[]
  supplierRequests   SupplierDataRequest[]
  productLedger      ProductLedgerEntry[]
  recallMatches      RecallMatch[]
}

enum Plan {
  FREE
  STARTER
  PRO
}

// Lifetime product ledger: one row per unique product that EVER had compliance
// data. Rows are never deleted when products/compliance are deleted — this is
// what enforces the lifetime free cap (10) and Starter cap (250).
model ProductLedgerEntry {
  id               String   @id @default(cuid())
  shopId           String
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyProductId String
  createdAt        DateTime @default(now())

  @@unique([shopId, shopifyProductId])
}

model ResponsiblePerson {
  id             String   @id @default(cuid())
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  role           RpRole   @default(EU_RESPONSIBLE_PERSON)
  legalName      String
  companyName    String?
  streetAddress  String
  city           String
  postalCode     String
  country        String
  email          String
  phone          String
  isThirdParty   Boolean  @default(false)
  providerName   String?
  createdAt      DateTime @default(now())

  productCompliances ProductCompliance[]
}

enum RpRole {
  EU_RESPONSIBLE_PERSON
  UK_RESPONSIBLE_PERSON
  CH_RESPONSIBLE_PERSON
  MANUFACTURER_AS_RP
  IMPORTER_AS_RP
}

model Manufacturer {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  legalName     String
  tradeName     String?
  streetAddress String
  city          String
  postalCode    String
  country       String
  email         String?
  phone         String?
  createdAt     DateTime @default(now())

  productCompliances ProductCompliance[]
}

model ComplianceTemplate {
  id                  String   @id @default(cuid())
  shopId              String
  shop                Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name                String
  category            String?
  defaultWarnings     Json     @default("[]")
  defaultPictograms   String[] @default([])
  careInstructions    String?
  requiresCE          Boolean  @default(false)
  eprCategory         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  productCompliances ProductCompliance[]
}

model ProductCompliance {
  id                 String   @id @default(cuid())
  shopId             String
  shop               Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  shopifyProductId   String
  shopifyVariantId   String?
  productTitle       String?

  responsiblePersonId String?
  responsiblePerson   ResponsiblePerson? @relation(fields: [responsiblePersonId], references: [id])
  manufacturerId      String?
  manufacturer        Manufacturer?      @relation(fields: [manufacturerId], references: [id])
  templateId          String?
  template            ComplianceTemplate? @relation(fields: [templateId], references: [id])

  warnings           Json     @default("[]")
  pictograms         String[] @default([])
  careInstructions   String?
  gtin               String?
  modelNumber        String?
  batchNumber        String?
  serialNumber       String?
  ceMarked           Boolean  @default(false)
  ceDocumentId       String?
  eprRegistrationNo  String?

  appliedByBulk      Boolean  @default(false)
  isOverride         Boolean  @default(false)
  euOnly             Boolean  @default(true)

  status             ComplianceStatus @default(INCOMPLETE)
  missingFields      String[] @default([])
  lastScannedAt      DateTime?
  passportUrl        String?

  dppEnabled         Boolean  @default(false)
  dppQrCodeUrl       String?
  materialComposition Json?
  originCountry      String?
  sustainabilityData Json?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  channelStates      ChannelProductState[]

  @@unique([shopId, shopifyProductId, shopifyVariantId])
  @@index([shopId, status])
}

enum ComplianceStatus {
  INCOMPLETE
  READY
  PUBLISHED
  NEEDS_REVIEW
}

model ChannelProductState {
  id                  String   @id @default(cuid())
  productComplianceId String
  productCompliance   ProductCompliance @relation(fields: [productComplianceId], references: [id], onDelete: Cascade)
  channel             Channel
  syncedAt            DateTime?
  status              String   @default("pending")
  validatorPassed     Boolean  @default(false)
  errorDetail         String?

  @@unique([productComplianceId, channel])
}

enum Channel {
  SHOPIFY
  AMAZON
  TIKTOK
  EBAY
  ETSY
  TEMU
}

model ChannelExport {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  channel     Channel
  format      String
  fileUrl     String?
  rowCount    Int      @default(0)
  createdAt   DateTime @default(now())
}

model ComplianceDocument {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  kind        DocKind
  fileName    String
  fileUrl     String
  productId   String?
  retainUntil DateTime
  createdAt   DateTime @default(now())
}

enum DocKind {
  DECLARATION_OF_CONFORMITY
  TEST_REPORT
  RISK_ASSESSMENT
  TECHNICAL_FILE
  LABEL_ARTWORK
  CE_CERTIFICATE
  OTHER
}

model SupplierDataRequest {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supplierEmail String
  productRef    String?
  token         String  @unique
  status        String  @default("sent")
  submittedData Json?
  createdAt     DateTime @default(now())
}

model IncidentLog {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productRef  String?
  type        String
  description String
  actionTaken String?
  reportedToAuthority Boolean @default(false)
  occurredAt  DateTime
  createdAt   DateTime @default(now())
}

model AuditEvent {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  actor     String
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())
}

model WarningLibraryItem {
  id          String   @id @default(cuid())
  key         String   @unique
  category    String
  pictogramSvg String
  translations Json
  regulationRef String?
  version      Int     @default(1)
  updatedAt    DateTime @updatedAt
}


// ── EU Safety Gate (RAPEX) recall alerts ───────────────────────────────
// Global cache of published EU recall alerts, shared by all shops.
// Source: Safety Gate open data (weekly published alerts).
model RecallAlert {
  id            String   @id @default(cuid())
  alertNumber   String   @unique
  alertLevel    String?
  alertCountry  String?
  alertDate     DateTime?
  productName   String?
  productBrand  String?
  productType   String?
  productCategory String?
  productBarcode  String?
  description   String?
  riskType      String?
  rapexUrl      String?
  imageUrl      String?
  fetchedAt     DateTime @default(now())

  matches       RecallMatch[]

  @@index([alertDate])
  @@index([productBrand])
}

// A recall alert matched against a specific merchant product.
model RecallMatch {
  id               String   @id @default(cuid())
  shopId           String
  shop             Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  alertId          String
  alert            RecallAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  shopifyProductId String
  productTitle     String?
  matchReason      String
  matchScore       Int      @default(0)
  status           String   @default("NEW") // NEW | DISMISSED | ACTIONED
  createdAt        DateTime @default(now())

  @@unique([shopId, alertId, shopifyProductId])
  @@index([shopId, status])
}
